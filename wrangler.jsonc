// Situs statis murni: Worker tanpa kode, hanya melayani folder public/.
{
  "name": "bermudaku-games",
  "compatibility_date": "2026-11-01",
  // Domain kustom membuat rekaman DNS sendiri yang mengalahkan wildcard *.bmdku.com.
  "routes": [
    { "pattern": "games.bmdku.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
